{
  "name": "swasthyasetu-ai",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "24.18.1"
  },
  "scripts": {
    "frontend:lint": "pnpm --recursive --if-present lint",
    "frontend:typecheck": "pnpm --recursive --if-present typecheck",
    "frontend:test": "pnpm --recursive --if-present test",
    "frontend:build": "pnpm --filter @swasthyasetu/patient-web --filter @swasthyasetu/clinician-web --filter @swasthyasetu/admin-web build",
    "frontend:format-check": "prettier --check package.json pnpm-workspace.yaml tsconfig.base.json eslint.config.mjs prettier.config.mjs apps packages tests/e2e",
    "patient:dev": "pnpm --filter @swasthyasetu/patient-web dev",
    "clinician:dev": "pnpm --filter @swasthyasetu/clinician-web dev",
    "admin:dev": "pnpm --filter @swasthyasetu/admin-web dev",
    "e2e:list": "playwright test --config tests/e2e/playwright.config.ts --list",
    "e2e:test": "playwright test --config tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.2",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
