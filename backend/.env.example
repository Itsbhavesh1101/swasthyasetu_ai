# Safe local defaults. Copy this file to .env for local development.
SWASTHYASETU_APP_NAME=SwasthyaSetu AI
SWASTHYASETU_ENVIRONMENT=local
SWASTHYASETU_DEBUG=false
SWASTHYASETU_API_V1_PREFIX=/api/v1
SWASTHYASETU_LOG_LEVEL=INFO
SWASTHYASETU_OBSERVABILITY={"tracing_enabled":true,"metrics_enabled":true,"external_export_enabled":false,"service_name":"swasthyasetu-backend"}
SWASTHYASETU_FEATURES={"enabled":[]}
SWASTHYASETU_SESSIONS__PSEUDONYMOUS_TTL_MINUTES=60
SWASTHYASETU_SESSIONS__KIOSK_TTL_MINUTES=30

# Database connectivity stays disabled for generic host development/tests.
# Activate it only with a synthetic local PostgreSQL URL and migrate explicitly first.
# SWASTHYASETU_DATABASE__ENABLED=true
# SWASTHYASETU_DATABASE__URL=postgresql+psycopg://swasthyasetu_dev:local-only-synthetic-password@127.0.0.1:5432/swasthyasetu
# SWASTHYASETU_DATABASE__CONNECT_TIMEOUT_SECONDS=3
# SWASTHYASETU_DATABASE__POOL_TIMEOUT_SECONDS=5
